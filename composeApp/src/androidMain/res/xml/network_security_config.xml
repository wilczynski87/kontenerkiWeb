<?xml version="1.0" encoding="utf-8"?>
<!--
  API uses HTTP (not HTTPS). base-config must allow cleartext for IP hosts
  like 217.154.148.172 — domain-config alone is unreliable for IP literals on
  physical devices (especially release builds without debug-overrides).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
